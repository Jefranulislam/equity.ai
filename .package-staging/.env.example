# =============================================================================
# Equity.AI — Environment configuration (COPY to .env and fill in real values)
#   cp .env.example .env
# Never commit the real .env. Values below are placeholders only.
# =============================================================================

# -----------------------------------------------------------------------------
# Supabase (backend database + auth)  — https://supabase.com
# Project Settings → API
# -----------------------------------------------------------------------------
# Project URL, e.g. https://abcdefgh.supabase.co
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co

# Publishable ("anon") key — safe for the browser, protected by RLS policies
SUPABASE_PUBLISHABLE_KEY=PLACEHOLDER-YOUR-SUPABASE-ANON-KEY

# Service role key — SERVER ONLY, bypasses RLS. Never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=PLACEHOLDER-YOUR-SUPABASE-SERVICE-ROLE-KEY

# -----------------------------------------------------------------------------
# Browser build variables (Vite injects these at build time)
# Must mirror the server values above.
# -----------------------------------------------------------------------------
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=PLACEHOLDER-YOUR-SUPABASE-ANON-KEY

# Supabase project reference (optional; not required for a standard deployment)
# VITE_SUPABASE_PROJECT_ID=YOUR-PROJECT-REF

# -----------------------------------------------------------------------------
# Docker (optional) — port mapping for docker-compose.yml
# -----------------------------------------------------------------------------
# APP_PORT=8787

# -----------------------------------------------------------------------------
# Freya AI finance analyst (beta) — /api/chat
# Users can connect their own OpenRouter key in Settings → AI without server env.
# For a platform-wide provider, set any OpenAI-compatible endpoint:
# AI_API_KEY=PLACEHOLDER-YOUR-AI-KEY
# AI_BASE_URL=https://openrouter.ai/api/v1
# AI_MODEL=google/gemini-2.5-flash
#
# If no AI key is configured, the app runs fully except the /api/chat route
# (which returns a clear "not configured" response).
# -----------------------------------------------------------------------------
